# Copy thành .env và điền giá trị thật. KHÔNG commit file .env lên Git.

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

APP_NAME=FAQ Chatbot Agent
APP_VERSION=1.0.0

# Bảo mật — BẮT BUỘC đổi khác mặc định khi chạy production
API_KEY=dev-key-doi-trong-production
ALLOWED_ORIGINS=*

# Giới hạn
RATE_LIMIT_PER_MINUTE=15
DAILY_BUDGET_USD=2.0

# LLM (để trống thì dùng FAQ brain offline)
OPENAI_API_KEY=
